# templates/dashboard/comptabilite/payment_form.html
msgid "Paiement étudiant — Univers Academy"
msgstr "Student payment — Univers Academy"

msgid "Encaisser un paiement étudiant"
msgstr "Collect a student payment"

msgid "Choisissez l'étudiant, puis son inscription : le paiement crée une opération de caisse et un reçu."
msgstr "Choose the student, then their enrollment: the payment creates a cash transaction and a receipt."

msgid "Enregistrer le paiement"
msgstr "Save the payment"

msgid "Un paiement partiel ne solde pas le dossier : le reste à payer est recalculé après chaque règlement."
msgstr "A partial payment does not settle the record: the balance due is recomputed after every payment."

msgid "Seules les inscriptions validées sont encaissables."
msgstr "Only validated enrollments can be paid into."

msgid "Inscriptions en attente de validation"
msgstr "Enrollments awaiting validation"

msgid "%(n)s a une inscription en attente : elle deviendra encaissable dès que la direction l'aura validée."
msgstr "%(n)s has a pending enrollment: it will become payable as soon as management has validated it."

msgid "Créée le %(d)s · net %(n)s FCFA · %(s)s"
msgstr "Created on %(d)s · net %(n)s FCFA · %(s)s"

msgid "Ouvrir le dossier"
msgstr "Open the record"

msgid "Inscrire un étudiant"
msgstr "Enroll a student"

msgid "L'inscription créée ici reste <strong>en attente</strong> : la direction doit la valider avant que le premier encaissement soit possible. Le tarif est repris du catalogue si le champ est laissé vide."
msgstr "The enrollment created here stays <strong>pending</strong>: management must validate it before the first payment can be collected. The fee is taken from the catalog when this field is left blank."

msgid "Créer l'inscription"
msgstr "Create the enrollment"

msgid "Comptes étudiants sans inscription"
msgstr "Student accounts without enrollment"

msgid "Un encaissement suppose une inscription validée : ces comptes actifs n'ont encore aucune inscription au dossier."
msgstr "Collecting a payment requires a validated enrollment: these active accounts have no enrollment on file yet."

msgid "Code"
msgstr "Code"

msgid "Action"
msgstr "Action"

msgid "Inscrire"
msgstr "Enroll"

msgid "À inscrire par le secrétariat"
msgstr "To be enrolled by the secretary"

msgid "Reste à payer sur ce dossier :"
msgstr "Balance due on this record:"

msgid "Dossier soldé : aucun montant ne reste à encaisser."
msgstr "Record fully paid: no amount remains to collect."


