# Gabarit d'environnement pour un déploiement PythonAnywhere du projet academy.
# À copier en .env à la racine du projet sur le serveur :
#   cp .env.pythonanywhere.example .env
# puis à éditer (nom de compte, SECRET_KEY, SMTP).

# OBLIGATOIRE en production (DEBUG=False) : 50 caractères minimum, unique.
# Générez-la ainsi :
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-50-caracteres-minimum-en-production

# Sur PythonAnywhere, DEBUG doit toujours rester False : les erreurs vivent
# dans l'onglet Web -> Error log, jamais dans une page publique.
DEBUG=False

# Remplacez votre-compte par votre identifiant PythonAnywhere.
ALLOWED_HOSTS=votre-compte.pythonanywhere.com
CSRF_TRUSTED_ORIGINS=https://votre-compte.pythonanywhere.com

# Base de données : ne définissez pas DATABASE_URL, le projet bascule alors
# sur SQLite à la racine (db.sqlite3), le bon choix pour ce déploiement
# mono-établissement. Sauvegarde = simple copie du fichier.

SUPERADMIN_SETUP_SECRET=change-me-secret-setup-key

# SMTP : les comptes gratuits PythonAnywhere bloquent les connexions sortantes
# SMTP ; avec un forfait payant, Gmail exige un mot de passe d'application
# (compte Google -> Sécurité -> Validation en deux étapes -> Mots de passe
# d'application) : le mot de passe du compte ne suffit plus.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=universeacademy70@gmail.com
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Univers Academy <universeacademy70@gmail.com>

# Mesure d'audience (facultatif) : laissez vide pour ne rien envoyer.
#GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Synchronisation Google Sheets (facultatif, docs/SYNCHRONISATION_GOOGLE.md) :
# déposez le JSON du compte de service hors du dépôt, p. ex.
# /home/votre-compte/secrets/service-account.json, et pointez la variable :
#GOOGLE_APPLICATION_CREDENTIALS=/home/votre-compte/secrets/service-account.json
#CLASSEURS_GOOGLE_IDS=id-de-la-feuille-1,id-de-la-feuille-2

TIME_ZONE=Africa/Brazzaville
